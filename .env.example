# Application
APP_ENV=development
APP_DEBUG=false
APP_NAME=Opportunity Engine
APP_VERSION=0.1.0
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database — SQLite for local/demo, PostgreSQL for production
# PostgreSQL example: postgresql+asyncpg://opportunity:opportunity@localhost:5432/opportunity_engine
DATABASE_URL=sqlite+aiosqlite:///./data/opportunity_engine.db

# HTTP client behaviour (responsible collection)
REQUEST_TIMEOUT=20
REQUEST_MAX_RETRIES=3
REQUEST_RATE_LIMIT=1.0
REQUEST_DELAY_SECONDS=0.5
USER_AGENT=OpportunityEngine/0.1 (+https://example.local/bot; responsible-automation)
RESPECT_ROBOTS_TXT=true

# Optional SMTP — leave blank for local/demo (console notifications still work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@localhost
SMTP_USE_TLS=true

# Optional outbound webhook — leave blank to disable
WEBHOOK_URL=

# Optional enrichment provider (none | echo)
ENRICHMENT_PROVIDER=none

# Prefect (optional; CLI demo runs in-process without a Prefect server)
PREFECT_API_URL=
